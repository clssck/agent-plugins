{# --- TRADEOFF DEFINITIONS PER TECHNOLOGY --- #}
{%- set dt_tradeoffs = 'No row-level error handling — refresh is all-or-nothing. Target lag is a floor, not a guarantee — complex queries may refresh slower. Limited debugging for refresh failures. No Python UDFs in DT definitions.' -%}
{%- set st_tradeoffs = 'Operational overhead — schedules to manage and monitor. No built-in lineage or documentation framework. Each stream+task pair is independently managed. More moving parts to debug.' -%}
{%- set snowpark_tradeoffs = 'Requires Python/Scala expertise. Higher warehouse cost for DataFrame operations vs SQL. Less mature ecosystem than dbt for data engineering. No declarative refresh model — must build orchestration.' -%}
{%- set dbt_native_tradeoffs = 'Task-scheduled only (no auto-refresh). Native dbt is newer with fewer community packages available. Limited to SQL (no Python models on native). Debugging requires Snow CLI.' -%}
{%- set dbt_external_tradeoffs = 'Requires external orchestration (Airflow/dbt Cloud). Not Snowflake-native — adds external dependency. Potential cost of external tool licensing. Network connectivity requirements between dbt and Snowflake.' -%}
{%- set dbt_dt_tradeoffs = 'Combines DT limitations with dbt limitations. DT materialization not supported for all dbt model types. Incremental models may not behave as expected when materialized as DTs. Newer pattern with less community documentation.' -%}
{%- set sp_tradeoffs = 'Imperative, not declarative — harder to maintain at scale. No built-in lineage or testing framework. Procedural code is harder to review and audit. Limited parallelism compared to SQL-based approaches.' -%}


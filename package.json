{
  "name": "agent-plugins",
  "version": "1.0.0",
  "private": true,
  "description": "OMP extension packs. Install with `omp plugin install github:clssck/agent-plugins`, then link the packs you want.",
  "license": "MIT",
  "repository": "https://github.com/clssck/agent-plugins",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json --type-aware --deny-warnings scripts",
    "lint:fix": "oxlint -c .oxlintrc.json --type-aware --deny-warnings --fix scripts",
    "fmt": "oxfmt -c .oxfmtrc.json scripts",
    "fmt:check": "oxfmt -c .oxfmtrc.json --check scripts",
    "test": "bun test scripts",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "omp": {}
}
